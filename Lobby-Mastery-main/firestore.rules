rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección usuarios:
    //   - Lectura pública (el login necesita verificar email ANTES de autenticar)
    //   - Escritura solo para usuarios autenticados
    match /usuarios/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración (admin, zoom):
    //   - Lectura pública (se necesita verificar rol admin antes de auth)
    //   - Escritura solo para usuarios autenticados
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo lo demás: denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
